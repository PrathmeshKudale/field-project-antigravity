# ProofPath — environment variables
# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./proofpath_dev.db

# ── Security ─────────────────────────────────────────────────
APP_SECRET_KEY=change-me-in-production-use-32-random-chars

# ── Google OAuth 2.0 ─────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ── App Mode ─────────────────────────────────────────────────
# "reviewed" = real uploaded policy documents (no demo banner)
# "demo"     = bundled demo corpus (shows DEMO DATA banner)
CORPUS_MODE=reviewed

# ── LLM (optional — set for live mode) ──────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODE=replay
